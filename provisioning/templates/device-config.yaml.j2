## Generated by provisioning/scripts/bulk_provision.py — do not edit by hand.
## Regenerate from provisioning/inventory/devices.example.yaml instead.
device:
  id: {{ device_id }}
  type: {{ device_type }}

controller:
  api_endpoint: "{{ api_endpoint }}"
  mqtt_host: "{{ mqtt_host }}"
  mqtt_port: {{ mqtt_port }}

heartbeat:
  interval_seconds: {{ heartbeat_interval_seconds }}

logging:
  level: INFO

agent:
  credential_path: "/etc/device-agent/{{ device_id }}.credential"

enrollment:
  # One-time token issued by POST /api/v1/devices/register. Consumed the
  # first time the agent starts; ignored once a credential file exists at
  # agent.credential_path. Treat this bundle as a secret in transit.
  token: "{{ enrollment_token }}"

telemetry:
  simulate_gpu: {{ simulate_gpu | lower }}
