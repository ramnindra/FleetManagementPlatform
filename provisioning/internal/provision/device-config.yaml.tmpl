## Generated by provisioning/cmd/bulk-provision — do not edit by hand.
## Regenerate from provisioning/inventory/devices.example.yaml instead.
device:
  id: {{ .DeviceID }}
  type: {{ .DeviceType }}

controller:
  api_endpoint: "{{ .APIEndpoint }}"
  mqtt_host: "{{ .MQTTHost }}"
  mqtt_port: {{ .MQTTPort }}

heartbeat:
  interval_seconds: {{ .HeartbeatIntervalSeconds }}

logging:
  level: INFO

agent:
  credential_path: "/etc/device-agent/{{ .DeviceID }}.credential"

enrollment:
  # One-time token issued by POST /api/v1/devices/register. Consumed the
  # first time the agent starts; ignored once a credential file exists at
  # agent.credential_path. Treat this bundle as a secret in transit.
  token: "{{ .EnrollmentToken }}"

telemetry:
  simulate_gpu: {{ .SimulateGPU }}
